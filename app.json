{
  "expo": {
    "name": "Strength Cycle",
    "slug": "strength-cycle",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/app-icon-1024.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "scheme": "strengthcycle",
    "splash": {
      "image": "./assets/app-icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.strengthcycle.app",
      "buildNumber": "14",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Strength"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-1024.png",
        "backgroundColor": "#000000"
      },
      "package": "com.strengthcycle.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdcc3b83-b367-4ba0-9b40-69c740d993f0"
      }
    }
  }
}
